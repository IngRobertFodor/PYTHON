# Land Research Invest - Environment Variables
# Copy this file to .env and fill in the values

# --- LLM (required) ---
GOOGLE_API_KEY=your_gemini_api_key_here

# --- LLM fallback (optional) ---
ANTHROPIC_API_KEY=

# --- App settings ---
PORT=5001
FLASK_DEBUG=True

# --- Notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=
